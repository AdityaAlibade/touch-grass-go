<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Dark Fantasy RPG Theme -->
    <style name="Theme.TouchGrass" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/bg_dark_realm</item>
        <item name="colorPrimaryContainer">@color/green_dark_badge</item>
        <item name="colorOnPrimaryContainer">@color/green_light</item>

        <!-- Secondary & Accent Colors -->
        <item name="colorSecondary">@color/gold_rpg</item>
        <item name="colorOnSecondary">@color/bg_dark_realm</item>

        <!-- Background & Surface Colors -->
        <item name="android:colorBackground">@color/bg_dark_realm</item>

        <!-- System Bar Styling -->
        <item name="android:statusBarColor">@color/bg_dark_realm</item>
        <item name="android:navigationBarColor">@color/bg_dark_realm</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
