<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/ai_generator_title"
                    android:src="@drawable/ic_sparkle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/ai_generator_title"
                    android:textColor="@color/green_light"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Gemma 2 2B"
                android:textColor="@color/gold_rpg"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- FORM INPUTS CONTAINER -->
        <LinearLayout
            android:id="@+id/layoutAiInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/ai_interests_header"
                android:textColor="@color/green_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Interests Checkboxes -->
            <CheckBox
                android:id="@+id/cbPlants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="🌿 Plants &amp; Trees"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbBirds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐦 Birds &amp; Wildlife Sounds"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Outdoor Photography"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbWalking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶 Mindful Walking"
                android:textColor="@color/text_primary" />

            <!-- Environment Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="@string/ai_environment_header"
                android:textColor="@color/green_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEnvironment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbPark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Park / Garden"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbUrban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urban Neighborhood"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbStreet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiet Street"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Duration Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="@string/ai_time_header"
                android:textColor="@color/green_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb10m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="10 Mins"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb15m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="15 Mins"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb30m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="30 Mins"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Generate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateAiQuest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/btn_generate_ai_quest"
                android:textColor="@color/bg_dark_realm"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_sparkle"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/bg_dark_realm" />

        </LinearLayout>

        <!-- LOADING CONTAINER -->
        <LinearLayout
            android:id="@+id/layoutAiLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/green_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ai_loading_message"
                android:textColor="@color/green_light"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PREVIEW CONTAINER -->
        <LinearLayout
            android:id="@+id/layoutAiPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAiCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/green_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Nature Observation" />

                <TextView
                    android:id="@+id/tvAiDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="15 mins" />

                <TextView
                    android:id="@+id/tvAiXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/gold_rpg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="+35 XP" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAiName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="✨ AI Quest: Flora Pattern Collector" />

            <TextView
                android:id="@+id/tvAiDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Explore a Park for 15 minutes and find 3 trees with distinctly different leaf shapes." />

            <!-- Safety Note Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_green"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Safety Note"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/green_light" />

                <TextView
                    android:id="@+id/tvAiSafetyNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/green_light"
                    android:textSize="12sp"
                    tools:text="Safety Note: Stay on designated footpaths and stay hydrated." />
            </LinearLayout>

            <!-- Inference Source Tag -->
            <TextView
                android:id="@+id/tvAiInferenceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_disabled"
                android:textSize="11sp"
                tools:text="Inference: Gemma 2 2B (Local Dev Model)" />

            <!-- Accept AI Quest Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptAiQuest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_accept_ai_quest"
                android:textColor="@color/bg_dark_realm"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
