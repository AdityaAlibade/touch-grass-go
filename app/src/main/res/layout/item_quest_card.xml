<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Badges Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCardCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/green_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Mindfulness" />

                <TextView
                    android:id="@+id/tvCardDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="10 mins" />
            </LinearLayout>

            <!-- Status Tag -->
            <TextView
                android:id="@+id/tvCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/gold_rpg"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ACTIVE" />
        </RelativeLayout>

        <!-- Quest Title -->
        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="NPC Walk" />

        <!-- Quest Description -->
        <TextView
            android:id="@+id/tvCardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Walk for 10 minutes without checking social media or screens. Observe your surroundings as a peaceful NPC." />

        <!-- Reward & Action Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvCardXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/gold_rpg"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="+25 XP" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <!-- View on Map Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCardViewMap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/btn_view_on_map"
                    android:textColor="@color/green_light"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/surface_card_stroke" />

                <!-- Accept Quest Button (visible when AVAILABLE) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCardAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/btn_accept_quest"
                    android:textColor="@color/bg_dark_realm"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="8dp" />

                <!-- Complete Quest Button (visible when ACTIVE) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCardComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/btn_complete_quest"
                    android:textColor="@color/bg_dark_realm"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/gold_rpg"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
