<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_realm">

    <!-- Interactive OpenStreetMap View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Map Header Bar Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#F018221B"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/surface_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/map_header_title"
                android:src="@drawable/ic_grass_blade" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/map_header_title"
                    android:textColor="@color/green_light"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_header_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Offline / Network Warning Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bannerOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardMapHeader"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#D93A2410"
        app:cardCornerRadius="10dp"
        app:strokeColor="#80FFB300"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/map_offline_notice"
                android:src="@drawable/ic_lock_quest"
                app:tint="@color/gold_rpg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/map_offline_notice"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Map Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressMapLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/green_primary"
        android:visibility="visible" />

    <!-- Custom Zoom Controls (Right Middle) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_zoom_in"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/surface_card_dark"
            app:fabCustomSize="44dp"
            app:maxImageSize="22dp"
            app:rippleColor="@color/green_dark_badge"
            app:strokeColor="@color/surface_card_stroke"
            app:strokeWidth="1dp"
            app:tint="@color/text_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cd_zoom_out"
            android:src="@drawable/ic_remove"
            app:backgroundTint="@color/surface_card_dark"
            app:fabCustomSize="44dp"
            app:maxImageSize="22dp"
            app:rippleColor="@color/green_dark_badge"
            app:strokeColor="@color/surface_card_stroke"
            app:strokeWidth="1dp"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- My Location FAB (Bottom Right above bottom nav) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/cd_my_location"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/surface_card_dark"
        app:fabCustomSize="52dp"
        app:maxImageSize="26dp"
        app:rippleColor="@color/green_primary"
        app:strokeColor="@color/green_dark_badge_stroke"
        app:strokeWidth="1.5dp"
        app:tint="@color/green_light" />

    <!-- OpenStreetMap Attribution Tag (Bottom Left) -->
    <TextView
        android:id="@+id/tvAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_badge_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/map_attribution"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</RelativeLayout>
