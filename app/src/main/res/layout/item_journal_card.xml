<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Date & XP -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvJournalDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Oct 24, 2026 at 4:15 PM" />

            <TextView
                android:id="@+id/tvJournalXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/gold_rpg"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="+35 XP" />
        </RelativeLayout>

        <!-- Quest Name -->
        <TextView
            android:id="@+id/tvJournalQuestName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="NPC Walk" />

        <!-- Badges Row: Category & Unlocked Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJournalCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/green_light"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Mindfulness" />

            <TextView
                android:id="@+id/tvJournalUnlockedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/gold_rpg"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="🏆 Title Unlocked: Certified Grass Toucher"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Optional Personal Reflection Note Box -->
        <LinearLayout
            android:id="@+id/layoutJournalReflection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_green"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Reflection:"
                android:textColor="@color/green_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJournalReflection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="italic"
                tools:text="Saw a peaceful old Banyan tree today and took 10 minutes to breathe fresh outdoor air." />
        </LinearLayout>

        <!-- Action Button: Add / Edit Note -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJournalAddNote"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="12dp"
                android:text="Add Note"
                android:textColor="@color/green_light"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/surface_card_stroke" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
